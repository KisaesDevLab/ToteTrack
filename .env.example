# ToteTrack — every value here is OPTIONAL. Everything a user needs is set in the app's Settings page.
# Copy to .env only if you want to override defaults (mostly for local development).

# --- Local development ---
# Dev postgres from docker-compose.dev.yml (pnpm db:dev). Production compose builds its own URL.
DATABASE_URL=postgres://tote:tote@localhost:5442/totetrack
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
PHOTO_DIR=./data/photos

# --- Optional overrides (Settings page values are used when these are empty) ---
# Session-signing secret. Auto-generated and stored in the DB on first boot if empty.
SESSION_SECRET=
# Anthropic key: if set here it overrides the key entered in Settings.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Public origin used inside QR codes. Empty = Settings value, else auto-detected from the address you browse on.
PUBLIC_URL=
# Cloudflare Tunnel connector token: if set here it overrides the token entered in Settings.
CLOUDFLARE_TUNNEL_TOKEN=
# Path to cloudflared for local dev (bundled at /usr/local/bin/cloudflared in Docker).
#CLOUDFLARED_BIN=C:/Program Files (x86)/cloudflared/cloudflared.exe

# --- docker-compose.yml only ---
# Postgres password inside the compose network (default: totetrack; only matters if you expose the port).
#POSTGRES_PASSWORD=
# Host port/interface the app is published on.
#APP_PORT=3000
#APP_BIND=127.0.0.1
