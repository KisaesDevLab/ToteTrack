# --- Database ---
# Local dev (docker-compose.dev.yml): postgres://tote:tote@localhost:5442/totetrack
# Production compose: postgres://tote:<password>@postgres:5432/totetrack
DATABASE_URL=postgres://tote:tote@localhost:5442/totetrack
# Used only by docker-compose.yml to initialise the postgres container
POSTGRES_PASSWORD=change-me

# --- Auth ---
# 32+ random bytes, e.g. `openssl rand -hex 32`
SESSION_SECRET=change-me-to-a-long-random-string

# --- AI (optional; auto-analyze disabled if ANTHROPIC_API_KEY is unset) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- App ---
# Public origin used in QR codes (Cloudflare Tunnel hostname)
PUBLIC_URL=http://localhost:5173
# Where photos are stored (named volume in docker)
PHOTO_DIR=./data/photos
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# --- docker-compose.yml only ---
# Host port/interface the app is published on (keep loopback; cloudflared runs on the host)
APP_PORT=3000
APP_BIND=127.0.0.1
