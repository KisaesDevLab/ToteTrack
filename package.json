{
  "name": "totetrack",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Self-hosted home inventory for storage totes",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"pnpm --filter @totetrack/server dev\" \"pnpm --filter @totetrack/web dev\"",
    "build": "pnpm --filter @totetrack/web build && pnpm --filter @totetrack/server build",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @totetrack/server test",
    "db:generate": "pnpm --filter @totetrack/server db:generate",
    "db:migrate": "pnpm --filter @totetrack/server db:migrate",
    "db:seed": "pnpm --filter @totetrack/server db:seed",
    "db:dev": "docker compose -f docker-compose.dev.yml up -d"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
